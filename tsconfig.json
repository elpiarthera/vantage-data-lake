{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ES2021", "dom"],
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"allowJs": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noEmit": true,
		"resolveJsonModule": true
	},
	"include": ["component/**/*.ts", "vitest.config.ts"],
	"exclude": ["node_modules"]
}
